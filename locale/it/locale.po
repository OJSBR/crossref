msgid "plugins.generic.crossref.displayName"
msgstr "Plugin gestore Crossref"

msgid "plugins.generic.crossref.description"
msgstr "Deposita i DOI e i metadati di monografie e capitoli su Crossref."

msgid "plugins.generic.crossref.registrationAgency.name"
msgstr "Crossref"

msgid "plugins.generic.crossref.successMessage"
msgstr "La proposta è stata accettata da Crossref con l'ID di proposta {$submissionId}. Il deposito potrebbe richiedere alcuni minuti per essere completamente elaborato."

msgid "plugins.importexport.crossref.displayName"
msgstr "Plugin di esportazione XML Crossref"

msgid "plugins.importexport.crossref.description"
msgstr "Esporta i metadati di monografie e capitoli nel formato XML di Crossref."

msgid "plugins.importexport.crossref.settings"
msgstr "Impostazioni Crossref"

msgid "plugins.importexport.crossref.settings.depositorIntro"
msgstr "I seguenti elementi sono necessari per un deposito riuscito su Crossref."

msgid "plugins.importexport.crossref.registrationIntro"
msgstr "Se desideri usare questo plugin per registrare gli identificatori di oggetto digitale (DOI) direttamente presso Crossref, avrai bisogno di un nome utente e di una password (disponibili presso il servizio di assistenza di Crossref). Se non disponi di un nome utente e di una password, puoi comunque esportare nel formato XML di Crossref, ma non potrai registrare i tuoi DOI presso Crossref da OMP."

msgid "plugins.importexport.crossref.settings.form.depositorName"
msgstr "Nome del depositante"

msgid "plugins.importexport.crossref.settings.form.depositorName.description"
msgstr "Il nome dell'organizzazione che registra i DOI."

msgid "plugins.importexport.crossref.settings.form.depositorEmail"
msgstr "E-mail del depositante"

msgid "plugins.importexport.crossref.settings.form.depositorEmail.description"
msgstr "L'indirizzo e-mail al quale Crossref invierà le conferme di deposito e gli avvisi di errore."

msgid "plugins.importexport.crossref.settings.form.username"
msgstr "Nome utente"

msgid "plugins.importexport.crossref.settings.form.username.description"
msgstr "Il tuo nome utente (ruolo) Crossref usato per depositare i DOI."

msgid "plugins.importexport.crossref.settings.form.testMode.description"
msgstr "Usa l'ambiente di test di Crossref (sandbox) anziché il sistema in produzione durante il deposito dei DOI. Ricordati di rimuovere questa opzione in produzione."

msgid "plugins.importexport.crossref.error.publisherNotConfigured"
msgstr "L'editore della casa editrice non è stato configurato. Devi indicare un <a href=\"{$contextSettingsUrl}\">editore</a> nelle impostazioni della casa editrice prima di poter depositare su Crossref."

msgid "plugins.importexport.crossref.register.error.mdsError"
msgstr "Il deposito non è andato a buon fine. Il server di Crossref ha restituito un errore. Controlla lo stato del deposito per i dettagli."

msgid "plugins.importexport.crossref.register.success.warning"
msgstr "Il deposito è andato a buon fine, ma Crossref ha restituito uno o più avvisi: {$param}"
