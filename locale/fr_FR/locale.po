msgid "plugins.generic.crossref.displayName"
msgstr "Plugin gestionnaire Crossref"

msgid "plugins.generic.crossref.description"
msgstr "Dépose les DOI et les métadonnées des monographies et des chapitres sur Crossref."

msgid "plugins.generic.crossref.registrationAgency.name"
msgstr "Crossref"

msgid "plugins.generic.crossref.successMessage"
msgstr "La soumission a été acceptée par Crossref avec l'identifiant de soumission {$submissionId}. Le dépôt peut prendre quelques minutes pour être entièrement traité."

msgid "plugins.importexport.crossref.displayName"
msgstr "Plugin d'export XML Crossref"

msgid "plugins.importexport.crossref.description"
msgstr "Exporte les métadonnées des monographies et des chapitres au format XML Crossref."

msgid "plugins.importexport.crossref.settings"
msgstr "Paramètres Crossref"

msgid "plugins.importexport.crossref.settings.depositorIntro"
msgstr "Les éléments suivants sont requis pour un dépôt réussi sur Crossref."

msgid "plugins.importexport.crossref.registrationIntro"
msgstr "Si vous souhaitez utiliser ce plugin pour enregistrer des identifiants d'objet numérique (DOI) directement auprès de Crossref, vous aurez besoin d'un nom d'utilisateur et d'un mot de passe (disponibles auprès du service d'assistance de Crossref). Si vous n'avez pas votre propre nom d'utilisateur et mot de passe, vous pouvez tout de même exporter au format XML Crossref, mais vous ne pourrez pas enregistrer vos DOI auprès de Crossref depuis OMP."

msgid "plugins.importexport.crossref.settings.form.depositorName"
msgstr "Nom du déposant"

msgid "plugins.importexport.crossref.settings.form.depositorName.description"
msgstr "Le nom de l'organisation qui enregistre les DOI."

msgid "plugins.importexport.crossref.settings.form.depositorEmail"
msgstr "Courriel du déposant"

msgid "plugins.importexport.crossref.settings.form.depositorEmail.description"
msgstr "L'adresse de courriel à laquelle Crossref enverra les confirmations de dépôt et les avis d'erreur."

msgid "plugins.importexport.crossref.settings.form.username"
msgstr "Nom d'utilisateur"

msgid "plugins.importexport.crossref.settings.form.username.description"
msgstr "Votre nom d'utilisateur (rôle) Crossref utilisé pour déposer les DOI."

msgid "plugins.importexport.crossref.settings.form.testMode.description"
msgstr "Utilisez l'environnement de test de Crossref (bac à sable) plutôt que le système en production lors du dépôt des DOI. N'oubliez pas de désactiver cette option en production."

msgid "plugins.importexport.crossref.error.publisherNotConfigured"
msgstr "L'éditeur de la maison d'édition n'a pas été configuré. Vous devez indiquer un <a href=\"{$contextSettingsUrl}\">éditeur</a> dans les paramètres de la maison d'édition avant de pouvoir déposer sur Crossref."

msgid "plugins.importexport.crossref.register.error.mdsError"
msgstr "Le dépôt a échoué. Le serveur Crossref a renvoyé une erreur. Veuillez consulter le statut du dépôt pour plus de détails."

msgid "plugins.importexport.crossref.register.success.warning"
msgstr "Le dépôt a réussi, mais Crossref a renvoyé un ou plusieurs avertissements : {$param}"
