msgid "plugins.generic.crossref.displayName"
msgstr "Complemento xestor de Crossref"

msgid "plugins.generic.crossref.description"
msgstr "Deposita en Crossref os DOI e os metadatos de monografías e capítulos."

msgid "plugins.generic.crossref.registrationAgency.name"
msgstr "Crossref"

msgid "plugins.generic.crossref.successMessage"
msgstr "Crossref aceptou o envío co identificador {$submissionId}. O procesamento pode tardar uns minutos."

msgid "plugins.importexport.crossref.displayName"
msgstr "Complemento de exportación Crossref XML"

msgid "plugins.importexport.crossref.description"
msgstr "Exporta os metadatos de monografías e capítulos no formato Crossref XML."

msgid "plugins.importexport.crossref.settings"
msgstr "Configuración de Crossref"

msgid "plugins.importexport.crossref.settings.depositorIntro"
msgstr "Os seguintes elementos son necesarios para un depósito correcto en Crossref."

msgid "plugins.importexport.crossref.registrationIntro"
msgstr "Se quere usar este complemento para rexistrar DOI directamente en Crossref, precisará un nome de persoa usuaria e un contrasinal. Sen iso aínda pode exportar o ficheiro XML e subilo a Crossref."

msgid "plugins.importexport.crossref.settings.form.depositorName"
msgstr "Nome do depositante"

msgid "plugins.importexport.crossref.settings.form.depositorName.description"
msgstr "O nome da organización que rexistra os DOI."

msgid "plugins.importexport.crossref.settings.form.depositorEmail"
msgstr "Correo do depositante"

msgid "plugins.importexport.crossref.settings.form.depositorEmail.description"
msgstr "O enderezo de correo ao que Crossref enviará as confirmacións de depósito e os avisos de erro."

msgid "plugins.importexport.crossref.settings.form.username"
msgstr "Nome de persoa usuaria"

msgid "plugins.importexport.crossref.settings.form.username.description"
msgstr "O seu nome de persoa usuaria (rol) de Crossref usado para depositar os DOI."

msgid "plugins.importexport.crossref.settings.form.testMode.description"
msgstr "Use o contorno de probas de Crossref (sandbox) no canto do sistema real ao depositar os DOI. Lembre desactivalo antes de pasar a produción."

msgid "plugins.importexport.crossref.error.publisherNotConfigured"
msgstr "Non se configurou a editora. Debe introducir unha editora na <a href=\"{$contextSettingsUrl}\">configuración da editorial</a>."

msgid "plugins.importexport.crossref.register.error.mdsError"
msgstr "O depósito non se completou. O servidor de Crossref devolveu un erro. Comprobe o estado do depósito."

msgid "plugins.importexport.crossref.register.success.warning"
msgstr "O depósito realizouse correctamente, pero Crossref devolveu un ou máis avisos: {$param}"
