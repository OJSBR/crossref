msgid "plugins.generic.crossref.displayName"
msgstr "Connector gestor de Crossref"

msgid "plugins.generic.crossref.description"
msgstr "Diposita a Crossref els DOI i les metadades de monografies i capítols."

msgid "plugins.generic.crossref.registrationAgency.name"
msgstr "Crossref"

msgid "plugins.generic.crossref.successMessage"
msgstr "Crossref ha acceptat la tramesa amb l'identificador {$submissionId}. El processament pot trigar uns minuts."

msgid "plugins.importexport.crossref.displayName"
msgstr "Connector d'exportació Crossref XML"

msgid "plugins.importexport.crossref.description"
msgstr "Exporta les metadades de monografies i capítols en format Crossref XML."

msgid "plugins.importexport.crossref.settings"
msgstr "Configuració de Crossref"

msgid "plugins.importexport.crossref.settings.depositorIntro"
msgstr "Els elements següents són necessaris per a un dipòsit correcte a Crossref."

msgid "plugins.importexport.crossref.registrationIntro"
msgstr "Si voleu emprar aquest connector per registrar DOI directament a Crossref, us caldrà un nom d'usuari i una contrasenya. Sense això encara podeu exportar el fitxer XML i pujar-lo a Crossref."

msgid "plugins.importexport.crossref.settings.form.depositorName"
msgstr "Nom del dipositant"

msgid "plugins.importexport.crossref.settings.form.depositorName.description"
msgstr "El nom de l'organització que registra els DOI."

msgid "plugins.importexport.crossref.settings.form.depositorEmail"
msgstr "Correu del dipositant"

msgid "plugins.importexport.crossref.settings.form.depositorEmail.description"
msgstr "L'adreça electrònica on Crossref enviarà les confirmacions de dipòsit i els avisos d'error."

msgid "plugins.importexport.crossref.settings.form.username"
msgstr "Nom d'usuari"

msgid "plugins.importexport.crossref.settings.form.username.description"
msgstr "El vostre nom d'usuari (rol) de Crossref emprat per dipositar els DOI."

msgid "plugins.importexport.crossref.settings.form.testMode.description"
msgstr "Utilitzeu l'entorn de proves de Crossref (sandbox) en lloc del sistema real per dipositar els DOI. Recordeu desactivar-ho abans de passar a producció."

msgid "plugins.importexport.crossref.error.publisherNotConfigured"
msgstr "No s'ha configurat l'editor de l'editorial. Heu d'introduir un editor a la <a href=\"{$contextSettingsUrl}\">configuració de l'editorial</a>."

msgid "plugins.importexport.crossref.register.error.mdsError"
msgstr "El dipòsit no s'ha completat. El servidor de Crossref ha retornat un error. Comproveu l'estat del dipòsit."

msgid "plugins.importexport.crossref.register.success.warning"
msgstr "El dipòsit s'ha fet correctament, però Crossref ha retornat un o més avisos: {$param}"
