msgid "plugins.generic.crossref.displayName"
msgstr "Plugin gestor de Crossref"

msgid "plugins.generic.crossref.description"
msgstr "Deposita los DOI y metadatos de monografías y capítulos en Crossref."

msgid "plugins.generic.crossref.registrationAgency.name"
msgstr "Crossref"

msgid "plugins.generic.crossref.successMessage"
msgstr "El envío fue aceptado por Crossref con el ID de envío {$submissionId}. El depósito puede tardar algunos minutos en procesarse por completo."

msgid "plugins.importexport.crossref.displayName"
msgstr "Plugin de exportación XML de Crossref"

msgid "plugins.importexport.crossref.description"
msgstr "Exporta los metadatos de monografías y capítulos en el formato XML de Crossref."

msgid "plugins.importexport.crossref.settings"
msgstr "Configuración de Crossref"

msgid "plugins.importexport.crossref.settings.depositorIntro"
msgstr "Los siguientes elementos son necesarios para un depósito exitoso en Crossref."

msgid "plugins.importexport.crossref.registrationIntro"
msgstr "Si desea usar este plugin para registrar identificadores de objeto digital (DOI) directamente en Crossref, necesitará un nombre de usuario y una contraseña (disponibles en el servicio de soporte de Crossref). Si no tiene su propio nombre de usuario y contraseña, todavía puede exportar al formato XML de Crossref, pero no podrá registrar sus DOI en Crossref desde OMP."

msgid "plugins.importexport.crossref.settings.form.depositorName"
msgstr "Nombre del depositante"

msgid "plugins.importexport.crossref.settings.form.depositorName.description"
msgstr "El nombre de la organización que registra los DOI."

msgid "plugins.importexport.crossref.settings.form.depositorEmail"
msgstr "Correo electrónico del depositante"

msgid "plugins.importexport.crossref.settings.form.depositorEmail.description"
msgstr "La dirección de correo electrónico a la que Crossref enviará las confirmaciones de depósito y los avisos de error."

msgid "plugins.importexport.crossref.settings.form.username"
msgstr "Nombre de usuario"

msgid "plugins.importexport.crossref.settings.form.username.description"
msgstr "Su nombre de usuario (rol) de Crossref usado para depositar los DOI."

msgid "plugins.importexport.crossref.settings.form.testMode.description"
msgstr "Use el entorno de prueba de Crossref (sandbox) en lugar del sistema en producción al depositar los DOI. Recuerde quitar esta opción en producción."

msgid "plugins.importexport.crossref.error.publisherNotConfigured"
msgstr "No se ha configurado el editor de la editorial. Debe indicar un <a href=\"{$contextSettingsUrl}\">editor</a> en la configuración de la editorial antes de poder depositar en Crossref."

msgid "plugins.importexport.crossref.register.error.mdsError"
msgstr "El depósito no fue exitoso. El servidor de Crossref devolvió un error. Consulte el estado del depósito para más detalles."

msgid "plugins.importexport.crossref.register.success.warning"
msgstr "El depósito fue exitoso, pero Crossref devolvió una o más advertencias: {$param}"
