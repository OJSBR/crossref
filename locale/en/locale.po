msgid "plugins.generic.crossref.displayName"
msgstr "Crossref Manager Plugin"

msgid "plugins.generic.crossref.description"
msgstr "Deposit monograph and chapter DOIs and metadata to Crossref."

msgid "plugins.generic.crossref.registrationAgency.name"
msgstr "Crossref"

msgid "plugins.generic.crossref.successMessage"
msgstr "The submission was accepted by Crossref with the submission ID {$submissionId}. It may take a few minutes for the deposit to be fully processed."

msgid "plugins.importexport.crossref.displayName"
msgstr "Crossref XML Export Plugin"

msgid "plugins.importexport.crossref.description"
msgstr "Export monograph and chapter metadata in the Crossref XML format."

msgid "plugins.importexport.crossref.settings"
msgstr "Crossref settings"

msgid "plugins.importexport.crossref.settings.depositorIntro"
msgstr "The following items are required for a successful deposit to Crossref."

msgid "plugins.importexport.crossref.registrationIntro"
msgstr "If you wish to use this plugin to register Digital Object Identifiers (DOIs) directly with Crossref, you will need a username and password (available from the Crossref support desk). If you do not have your own username and password you can still export to the Crossref XML format, but you cannot register your DOIs with Crossref from within OMP."

msgid "plugins.importexport.crossref.settings.form.depositorName"
msgstr "Depositor name"

msgid "plugins.importexport.crossref.settings.form.depositorName.description"
msgstr "The name of the organization registering the DOIs."

msgid "plugins.importexport.crossref.settings.form.depositorEmail"
msgstr "Depositor email"

msgid "plugins.importexport.crossref.settings.form.depositorEmail.description"
msgstr "The email address at which Crossref will send deposit confirmations and error notices."

msgid "plugins.importexport.crossref.settings.form.username"
msgstr "Username"

msgid "plugins.importexport.crossref.settings.form.username.description"
msgstr "Your Crossref username (role) used to deposit DOIs."

msgid "plugins.importexport.crossref.settings.form.testMode.description"
msgstr "Use the Crossref test environment (sandbox) rather than the live system when depositing DOIs. Please remember to remove this option for production."

msgid "plugins.importexport.crossref.error.publisherNotConfigured"
msgstr "The press publisher has not been configured. You must enter a <a href=\"{$contextSettingsUrl}\">publisher</a> in the press settings before you can deposit to Crossref."

msgid "plugins.importexport.crossref.register.error.mdsError"
msgstr "The deposit was not successful. The Crossref server returned an error. Please check the deposit status for details."

msgid "plugins.importexport.crossref.register.success.warning"
msgstr "The deposit was successful, but Crossref returned one or more warnings: {$param}"
